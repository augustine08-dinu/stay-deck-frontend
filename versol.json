{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_API_URL": "https://stay-deck-backend.onrender.com/api",
    "VITE_WS_URL": "wss://stay-deck-backend.onrender.com",
    "VITE_QR_BASE_URL": "https://staydeck-frontend.vercel.app/guest"
  }
}
